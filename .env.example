# ==============================================================================
# VULP — Visual Workflow Automation Platform
# Environment Variable Configuration Template (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# Database Storage Directory
# SQLite database files and master key will be stored here.
DB_DIR=./data

# Master Encryption Key (AES-256-GCM)
# 64-character hexadecimal string (32 bytes).
# If left blank, VULP will automatically generate one in $DB_DIR/master.key on first run.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WF_MASTER_KEY=

# Allowed CORS Origins (comma-separated for multiple origins)
# Example: http://localhost:5173,https://vulp.example.com
CORS_ORIGIN=http://localhost:5173

# Public Webhook Base URL
# External systems use this URL to trigger webhooks.
WEBHOOK_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Integration (Gmail, Sheets, Drive, Calendar, Forms)
# ------------------------------------------------------------------------------
# Create OAuth credentials in the Google Cloud Console:
# 1. Enable APIs: Gmail, Google Drive, Google Sheets, Google Calendar, Google Forms
# 2. Configure OAuth consent screen
# 3. Create Web Application credentials with the Authorized Redirect URI below
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/callback/google

# ------------------------------------------------------------------------------
# Frontend Application (Vite / React)
# ------------------------------------------------------------------------------
# Optional API Base URL. Leave empty if served from the same domain or behind reverse proxy.
VITE_API_BASE=


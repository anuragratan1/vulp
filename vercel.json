{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "npm run build --workspace=@workflow/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://vulp-studio.workflow-worker.workers.dev/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://vulp-studio.workflow-worker.workers.dev/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

